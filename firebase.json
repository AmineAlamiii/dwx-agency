{
  "functions": [{"source":"firebase/functions","codebase":"enquiries","predeploy":["npm --prefix \"$RESOURCE_DIR\" run build"],"ignore":["node_modules","test","*.log"]}],
  "firestore": {"rules":"firebase/firestore.rules","indexes":"firebase/firestore.indexes.json"},
  "emulators": {"firestore":{"port":8089},"functions":{"port":5009},"ui":{"enabled":false},"singleProjectMode":true},
  "hosting": {
    "site": "dwx-agency-leads",
    "public": "dist/client",
    "predeploy": ["npm run build:firebase"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.map", "_headers", "data/README.md"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {"source": "**", "headers": [
        {"key": "Cache-Control", "value": "no-cache"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"},
        {"key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000"}
      ]},
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]},
      {"source": "**/*.rsc", "headers": [{"key": "Content-Type", "value": "text/x-component"}]}
    ]
  }
}
